# MinIO Dockerfile - Build from source
FROM golang:1.24-alpine AS builder

ARG REPO_URL
ARG COMMIT_ID
ARG SHORT_COMMIT_ID
ARG VERSION

ENV GOPATH=/go
ENV CGO_ENABLED=0

WORKDIR /workspace

RUN apk add -U --no-cache ca-certificates git curl bash

COPY . .

RUN echo "Building MinIO: ${VERSION} (${SHORT_COMMIT_ID})" && \
    go build -trimpath \
        -ldflags " \
            -s -w \
            -X github.com/minio/minio/cmd.Version=${VERSION} \
            -X github.com/minio/minio/cmd.CopyrightYear=$(date +%Y) \
            -X github.com/minio/minio/cmd.ReleaseTag=${VERSION} \
            -X github.com/minio/minio/cmd.CommitID=${COMMIT_ID} \
            -X github.com/minio/minio/cmd.ShortCommitID=${SHORT_COMMIT_ID} \
            -X github.com/minio/minio/cmd.GOPATH=${GOPATH} \
            -X github.com/minio/minio/cmd.GOROOT=$(go env GOROOT)" \
        -o /usr/bin/minio .

RUN /usr/bin/minio --version

RUN curl -sL https://dl.min.io/client/mc/release/linux-$(go env GOARCH)/mc -o /usr/bin/mc && \
    chmod +x /usr/bin/mc

RUN mv ./dockerscripts/curl-$(go env GOARCH) /go/bin/curl && chmod +x /go/bin/curl

FROM registry.access.redhat.com/ubi9/ubi-micro:latest

ARG REPO_URL
ARG VERSION

LABEL name="KBase MinIO" \
      vendor="KBase" \
      maintainer="KBase <help@kbase.us>" \
      version="${VERSION}" \
      summary="KBase MinIO - High Performance Object Storage" \
      description="MinIO object storage customized for KBase. API compatible with Amazon S3, 100% open-source." \
      org.opencontainers.image.title="KBase MinIO" \
      org.opencontainers.image.vendor="KBase" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="${REPO_URL}" \
      org.opencontainers.image.licenses="AGPL-3.0"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder --chmod=755 /usr/bin/minio /usr/bin/minio
COPY --from=builder --chmod=755 /usr/bin/mc /usr/bin/mc
COPY --from=builder --chmod=755 /go/bin/curl /usr/bin/curl
COPY --from=builder /workspace/CREDITS /licenses/CREDITS
COPY --from=builder /workspace/LICENSE /licenses/LICENSE
COPY --from=builder --chmod=755 /workspace/dockerscripts/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio"]